{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.9",
  "author": "thk7410@gmail.com",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": [
    "identity",
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": [
        "i18n.js",
        "content/ui_list_badge.js",
        "content/ui_detail_card.js",
        "content/content_main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["_locales/*/messages.json"],
      "matches": ["*://mail.google.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options/options.html"
}
